# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...
TAVILY_API_KEY=tvly-...
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
# The Lovable app calls this service at this URL (used only for CORS / reference)
AGENT_SERVICE_URL=http://localhost:8000
# Master switch: true = every endpoint returns canned demo JSON (H0 integration test).
# Flip to false once real agents are wired. Per-agent overrides live in config.py.
USE_STUBS=true
OPENAI_MODEL=gpt-4o
