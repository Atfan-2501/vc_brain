# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...
TAVILY_API_KEY=tvly-...
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
# The Lovable app calls this service at this URL (used only for CORS / reference)
AGENT_SERVICE_URL=http://localhost:8000
# Master switch: true = every endpoint returns canned demo JSON (H0 integration test).
USE_STUBS=true

# Granular capability flags (override the master). Turn on the DB + scanning NOW,
# keep the not-yet-built pipeline agents stubbed:
#   DB_WIRED=true   -> reads/writes real Supabase; /scan persists discovered founders
#   APPLY_LIVE      -> /apply runs the extraction->memo pipeline (leave false until agents built)
#   QUERY_LIVE      -> /query calls OpenAI
DB_WIRED=true
APPLY_LIVE=false
QUERY_LIVE=false
# SCORING_LIVE runs the 3-axis OpenAI scorer via /score (needs OPENAI_API_KEY). Flip on once
# founders are enriched and your OpenAI key is set on Render.
SCORING_LIVE=false
# GITHUB_TOKEN (optional) lifts GitHub enrichment rate limit 60/h -> 5000/h
# GITHUB_TOKEN=

# Handelsregister connector backend: fixture (safe/demo) | bundesapi | openregister
HANDELSREGISTER_BACKEND=fixture
# HANDELSREGISTER_API_KEY=   # only for the openregister backend

OPENAI_MODEL=gpt-4o
